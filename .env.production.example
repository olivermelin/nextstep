# ============================================================
# NextStep — Produktionsmiljö
# Kopiera denna fil till .env och fyll i värden på Railway/Render
# DELA ALDRIG denna fil med riktiga värden i git
# ============================================================

# --- Databas ---
DB_URL=jdbc:postgresql://<host>:5432/sobrietydb
DB_USERNAME=postgres
DB_PASSWORD=<starkt-lösenord>

# --- JPA (validate i prod, update lokalt) ---
JPA_DDL_AUTO=validate

# --- Flyway ---
FLYWAY_ENABLED=true

# --- AI Coach ---
AI_COACH_ENABLED=true
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5
USE_GROQ=false
# GROQ_API_KEY=  (behövs ej i prod om USE_GROQ=false)

# --- E-post ---
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=<sendgrid-api-key>
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SENDER_EMAIL=noreply@nextstep.se
MAIL_SENDER_NAME=NextStep

# --- Google OAuth2 (valfritt) ---
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=

# --- Frontend (Vercel) ---
# Sätt i Vercel dashboard under Environment Variables
VITE_API_URL=https://api.nextstep.se/api
