{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd backend && mvnw.cmd spring-boot:run"],
      "port": 8080
    },
    {
      "name": "frontend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd frontend && npx vite --host localhost"],
      "port": 8082,
      "autoPort": true
    }
  ]
}
